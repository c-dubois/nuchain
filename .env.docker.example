# See live demo at https://nuchain.vercel.app
BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com
NUC_CONTRACT_ADDRESS=0x7a8ed93c1eA030eC8F283e93Ff1BB008e57D4791
ADMIN_PRIVATE_KEY=replace-with-your-wallet-private-key
NUCHAIN_DEV_WALLET_ADDRESS=replace-with-your-wallet-address