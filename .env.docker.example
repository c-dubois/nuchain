# Django
SECRET_KEY=replace-with-any-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (Docker internal network)
DATABASE_URL=postgresql://nuchain_user:nuchain_password@postgres:5432/nuchain_db

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

